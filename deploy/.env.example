# deploy/.env 로 복사한 뒤 실제 값을 채운다. (.env는 커밋하지 않는다)

# Neo4j 인증 — neo4j 컨테이너(NEO4J_AUTH)와 ai-server(NEO4J_USER/PASSWORD)가 공유한다.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# OpenAI API 키 — Gate1/Gate2/Extract/Generate + 질의 임베딩(01_설계.md 2장, 3.3).
OPENAI_API_KEY=sk-...

# Upstage Solar API 키 — Gate1/Gate2/Extract/Generate의 기본 프로바이더.
# 비워두면 OpenAI만으로 동작한다(app/llm/provider.py의 프로바이더 체인 표 참고).
# 주의: 질의 임베딩은 프로바이더와 무관하게 항상 OpenAI이므로, 이 키만 채우고
# OPENAI_API_KEY를 비우면 Gate 1/2만 동작하고 Retrieve->Generate는 항상 실패한다.
UPSTAGE_API_KEY=up_...

# LLM 프로바이더 선택 — auto(기본) | upstage | openai
# auto: 키가 있는 쪽을 자동 선택한다. 둘 다 있으면 Upstage 우선 + OpenAI 폴백,
#       하나만 있으면 그것만 쓰고 폴백하지 않는다.
# upstage / openai: 해당 프로바이더로 고정하고 폴백하지 않는다(장애 원인 격리용).
LLM_PROVIDER=auto

# Gate 2 안내 문구에 넣을 이 포트폴리오 저장소의 공개 URL(00_기획.md "깃허브 링크 안내").
# 실제 배포에서는 반드시 채운다 — 비어 있으면 링크 없이 안내 문구만 반환된다.
GITHUB_REPO_URL=

# Nginx가 호스트에 노출하는 HTTP 포트 — Cloudflare Tunnel(cloudflared)이 이 포트를 가리킨다.
NGINX_HTTP_PORT=8080
