{
  "behavior": {
    "scaleDown": {
      "policies": [
        {
          "periodSeconds": 15,
          "type": "Percent",
          "value": 100
        }
      ],
      "selectPolicy": "Max",
      "stabilizationWindowSeconds": 300
    },
    "scaleUp": {
      "policies": [
        {
          "periodSeconds": 15,
          "type": "Pods",
          "value": 4
        },
        {
          "periodSeconds": 15,
          "type": "Percent",
          "value": 100
        }
      ],
      "selectPolicy": "Max",
      "stabilizationWindowSeconds": 0
    }
  },
  "maxReplicas": 5,
  "metrics": [
    {
      "resource": {
        "name": "cpu",
        "target": {
          "averageUtilization": 70,
          "type": "Utilization"
        }
      },
      "type": "Resource"
    }
  ],
  "minReplicas": 2,
  "scaleTargetRef": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "name": "service"
  }
}